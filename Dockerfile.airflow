FROM apache/airflow:2.7.1-python3.11

USER root
RUN apt-get update && apt-get install -y git gcc && rm -rf /var/lib/apt/lists/*

USER airflow

# Set PATH for user packages
ENV PATH="/home/airflow/.local/bin:${PATH}"

# Copy dependency files first
COPY pyproject.toml /opt/airflow/
COPY src/ /opt/airflow/src/

# Install NumPy 1.x first
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    "numpy==1.24.3" \
    "pandas==2.0.3"

# Install with fixed versions to avoid conflicts
RUN pip install --no-cache-dir \
    "duckdb==0.10.2" \
    "dbt-duckdb==1.7.0" \
    "dbt-core==1.7.0" \
    "requests>=2.28.0" \
    "pypdf>=4.0.0"

# Single install from pyproject.toml
# The numpy<2 constraint will be honoured
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e /opt/airflow/

# Verification
RUN python -c "import numpy; print(f'✅ numpy: {numpy.__version__}')" && \
    python -c "import pandas; print(f'✅ pandas: {pandas.__version__}')" && \
    python -c "import duckdb; print(f'✅ duckdb: {duckdb.__version__}')"