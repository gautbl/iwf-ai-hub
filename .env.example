# =============================================================================
# Configuration IWF AI Hub
# =============================================================================
# Copier ce fichier en .env et ajuster les valeurs pour l'environnement local.
# Les variables sont préfixées par IWF_ et chargées via pydantic-settings.
# =============================================================================

# Interface d'écoute (0.0.0.0 en conteneur, 127.0.0.1 en local)
IWF_HOST=0.0.0.0

# Port d'écoute HTTP
IWF_PORT=8000

# Niveau de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
IWF_LOG_LEVEL=INFO

# Chemin vers la base DuckDB de production
IWF_DUCKDB_PATH=data/duckdb/iwf_hub.duckdb

# Endpoint local Ollama (embeddings et LLM)
IWF_OLLAMA_URL=http://localhost:11434

# Modèle de chat local (ex: llama3.2)
IWF_LLM_MODEL=llama3.2
