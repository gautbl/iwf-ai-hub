{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/mimo-v2.5",
  "small_model": "opencode-go/mimo-v2.5",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "ask",
    "bash": "ask",
    "task": "ask",
    "skill": "allow",
    "webfetch": "deny",
    "websearch": "deny"
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "opencode-go/hy3",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "plan": {
      "mode": "primary",
      "model": "opencode-go/mimo-v2.5",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    }
  },
  "instructions": [
    "AGENTS.md",
    ".opencode/skill/pytest-conventions/SKILL.md",
    ".opencode/skill/duckdb-vss/SKILL.md"
  ]
}